{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "KCPS-EventSortieAnalysisRequest.schema.json",
  "title": "KCPS 活动出击分析请求",
  "type": "object",
  "required": [
    "SchemaVersion",
    "Kind",
    "Name",
    "Map",
    "Difficulty",
    "BattleNodes",
    "Goal",
    "Simulation",
    "FleetSearch",
    "BonusProfiles"
  ],
  "properties": {
    "SchemaVersion": {
      "const": 2
    },
    "Kind": {
      "const": "KcpsEventSortieAnalysisRequest"
    },
    "Name": {
      "type": "string",
      "minLength": 1
    },
    "Map": {
      "type": "string",
      "pattern": "^[0-9]+-[0-9]+$"
    },
    "Difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "RouteEdges": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "BattleNodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "Label",
          "Formation",
          "SubOnly"
        ],
        "properties": {
          "Label": {
            "type": "string",
            "minLength": 1
          },
          "Formation": {
            "type": "integer",
            "minimum": 1
          },
          "SubOnly": {
            "type": "boolean"
          },
          "AirRaid": {
            "type": "boolean"
          },
          "AirOnly": {
            "type": "boolean"
          },
          "NightBattle": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "Goal": {
      "type": "object",
      "required": [
        "TargetNode",
        "MinimumRank",
        "RequiredSuccesses",
        "Type",
        "IndependentRepeatedSuccesses"
      ],
      "properties": {
        "TargetNode": {
          "type": "string"
        },
        "MinimumRank": {
          "enum": [
            "S",
            "A",
            "B"
          ]
        },
        "RequiredSuccesses": {
          "type": "integer",
          "minimum": 1
        },
        "Type": {
          "const": "RankAtNode"
        },
        "IndependentRepeatedSuccesses": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "Simulation": {
      "type": "object",
      "required": [
        "ModelScope",
        "NumSims",
        "Seeds",
        "InitialState"
      ],
      "properties": {
        "ModelScope": {
          "const": "SingleFleetFixedRoute"
        },
        "NumSims": {
          "type": "integer",
          "minimum": 1
        },
        "Seeds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "InitialState": {
          "$ref": "#/$defs/initialState"
        }
      },
      "additionalProperties": false
    },
    "FleetSearch": {
      "type": "object",
      "required": [
        "FixedPositions",
        "VariableShipInstanceIds",
        "VariablePositions",
        "LoadoutSets",
        "PermuteShipOrder",
        "PermuteLoadoutAssignment",
        "EquipmentResolutionPositionOrder"
      ],
      "properties": {
        "FixedPositions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Position",
              "ShipInstanceId",
              "Loadout"
            ],
            "properties": {
              "Position": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "ShipInstanceId": {
                "type": "integer",
                "minimum": 1
              },
              "Loadout": {
                "type": "object",
                "required": [
                  "Name",
                  "MainSlots"
                ],
                "properties": {
                  "Name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "MainSlots": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "ExtraSlot": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "VariableShipInstanceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "VariablePositions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          }
        },
        "LoadoutSets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Name",
              "MainSlots"
            ],
            "properties": {
              "Name": {
                "type": "string",
                "minLength": 1
              },
              "MainSlots": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "ExtraSlot": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "PermuteShipOrder": {
          "type": "boolean"
        },
        "PermuteLoadoutAssignment": {
          "type": "boolean"
        },
        "EquipmentResolutionPositionOrder": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          }
        }
      },
      "additionalProperties": false
    },
    "BonusProfiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "Name",
          "Role",
          "Applicability",
          "Verified",
          "Source",
          "LastVerifiedJst"
        ],
        "properties": {
          "Name": {
            "type": "string",
            "minLength": 1
          },
          "Role": {
            "enum": [
              "Primary",
              "Sensitivity"
            ]
          },
          "Applicability": {
            "enum": [
              "Applicable",
              "NotApplicable"
            ]
          },
          "Verified": {
            "const": true
          },
          "Source": {
            "type": "string",
            "minLength": 1
          },
          "LastVerifiedJst": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "Multiplier": {
            "const": 1
          },
          "Model": {
            "const": "DamageMultiplier"
          },
          "ShipBonuses": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "DefaultDamage"
              ],
              "properties": {
                "DefaultDamage": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "ByNode": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "Applicability": {
                  "const": "NotApplicable"
                }
              }
            },
            "then": {
              "required": [
                "Multiplier"
              ],
              "properties": {
                "ShipBonuses": {
                  "maxProperties": 0
                }
              }
            },
            "else": {
              "required": [
                "Model",
                "ShipBonuses"
              ]
            }
          }
        ]
      }
    },
    "ResearchSources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "Kind",
          "Url",
          "RetrievedAtJst",
          "ContentFingerprint",
          "Confidence"
        ],
        "properties": {
          "Kind": {
            "type": "string",
            "minLength": 1
          },
          "Url": {
            "type": "string",
            "minLength": 1
          },
          "RetrievedAtJst": {
            "type": "string",
            "minLength": 1
          },
          "ContentFingerprint": {
            "type": "string",
            "minLength": 1
          },
          "Confidence": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "initialState": {
      "type": "object",
      "required": [
        "Kind",
        "Source",
        "Supply",
        "Hp",
        "Morale",
        "AircraftCounts",
        "ShipAircraftProficiency",
        "LandBaseAircraftProficiency"
      ],
      "properties": {
        "Kind": {
          "enum": [
            "Actual",
            "Baseline"
          ]
        },
        "Source": {
          "type": "string",
          "minLength": 1
        },
        "Supply": {
          "type": "object",
          "required": [
            "Mode"
          ],
          "properties": {
            "Mode": {
              "enum": [
                "Snapshot",
                "Explicit",
                "Full"
              ]
            },
            "Ships": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "FuelFraction",
                  "AmmoFraction"
                ],
                "properties": {
                  "FuelFraction": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "AmmoFraction": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "Mode": {
                    "const": "Explicit"
                  }
                }
              },
              "then": {
                "required": [
                  "Ships"
                ]
              }
            }
          ]
        },
        "Hp": {
          "type": "object",
          "required": [
            "Mode"
          ],
          "properties": {
            "Mode": {
              "enum": [
                "Snapshot",
                "Explicit",
                "Full"
              ]
            },
            "Ships": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "Mode": {
                    "const": "Explicit"
                  }
                }
              },
              "then": {
                "required": [
                  "Ships"
                ]
              }
            }
          ]
        },
        "Morale": {
          "type": "object",
          "required": [
            "Mode"
          ],
          "properties": {
            "Mode": {
              "enum": [
                "Snapshot",
                "Explicit"
              ]
            },
            "Ships": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "Mode": {
                    "const": "Explicit"
                  }
                }
              },
              "then": {
                "required": [
                  "Ships"
                ]
              }
            }
          ]
        },
        "AircraftCounts": {
          "type": "object",
          "required": [
            "Mode"
          ],
          "properties": {
            "Mode": {
              "enum": [
                "Snapshot",
                "Explicit",
                "Full"
              ]
            },
            "Ships": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "Mode": {
                    "const": "Explicit"
                  }
                }
              },
              "then": {
                "required": [
                  "Ships"
                ]
              }
            }
          ]
        },
        "ShipAircraftProficiency": {
          "type": "object",
          "required": [
            "Mode"
          ],
          "properties": {
            "Mode": {
              "enum": [
                "SnapshotDisplay",
                "ExplicitDisplay",
                "MaxDisplay"
              ]
            },
            "Equipment": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              }
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "Mode": {
                    "const": "ExplicitDisplay"
                  }
                }
              },
              "then": {
                "required": [
                  "Equipment"
                ]
              }
            }
          ]
        },
        "LandBaseAircraftProficiency": {
          "type": "object",
          "required": [
            "Mode",
            "Reason"
          ],
          "properties": {
            "Mode": {
              "const": "NotApplicable"
            },
            "Reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "Kind": {
                "const": "Actual"
              }
            }
          },
          "then": {
            "properties": {
              "Supply": {
                "properties": {
                  "Mode": {
                    "enum": [
                      "Snapshot",
                      "Explicit"
                    ]
                  }
                }
              },
              "Hp": {
                "properties": {
                  "Mode": {
                    "enum": [
                      "Snapshot",
                      "Explicit"
                    ]
                  }
                }
              },
              "AircraftCounts": {
                "properties": {
                  "Mode": {
                    "enum": [
                      "Snapshot",
                      "Explicit"
                    ]
                  }
                }
              },
              "ShipAircraftProficiency": {
                "properties": {
                  "Mode": {
                    "enum": [
                      "SnapshotDisplay",
                      "ExplicitDisplay"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
